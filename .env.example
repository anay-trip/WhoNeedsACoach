# Auth (set a long random value before sharing a public URL)
AUTH_JWT_SECRET=dev-only-change-me-please-set-in-prod
AUTH_ACCESS_TTL_SECONDS=900
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — prefer xAI for reviewers without a local GPU
XAI_API_KEY=
GROK_MODEL=grok-4.6

# Used only when XAI_API_KEY is unset
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:latest

# Persistence (defaults under the repo if unset)
# COACH_DB=data/coach.db
# COACH_TOKENS=data/tokens
# COACH_LOG=logs/coach.log

# Garmin MCP checkout (required only for integrations / history enrichment)
# GARMIN_REPO=/absolute/path/to/garmin_mcp

# CLI-only Garmin login helpers (not used by the HTTP register/login path)
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
